# =========================================================
# COMPTAFLOW - EXEMPLE DE CONFIGURATION
# =========================================================

# ---------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------

APP_NAME=ComptaFlow API

APP_ENV=development

DEBUG=false


# ---------------------------------------------------------
# POSTGRESQL
# ---------------------------------------------------------

DATABASE_URL=postgresql+psycopg2://comptaflow:comptaflow_dev_password@localhost:5433/comptaflow_db


# ---------------------------------------------------------
# REDIS
# ---------------------------------------------------------

REDIS_URL=redis://localhost:6380/0


# ---------------------------------------------------------
# JWT / SÉCURITÉ
# ---------------------------------------------------------

# IMPORTANT :
# remplacer cette valeur dans .env par une vraie clé
# longue et aléatoire.
#
# Ne jamais publier le vrai SECRET_KEY sur GitHub.

SECRET_KEY=remplacer-par-une-cle-secrete-longue-et-aleatoire


# Durée du JWT en minutes.
# 480 = 8 heures.

ACCESS_TOKEN_EXPIRE_MINUTES=480


# ---------------------------------------------------------
# CORS
# ---------------------------------------------------------

# Plusieurs URL séparées par des virgules.

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174


# ---------------------------------------------------------
# STOCKAGE
# ---------------------------------------------------------

STORAGE_PATH=./storage_local


# Taille maximum d'un document uploadé.

MAX_UPLOAD_SIZE_MB=20


# ---------------------------------------------------------
# OLLAMA
# ---------------------------------------------------------

OLLAMA_URL=http://localhost:11434

OLLAMA_MODEL=llama3.2:1b


# Conservé pour compatibilité avec l'ancien système.

AI_PROVIDER=local


# ---------------------------------------------------------
# GROQ
# ---------------------------------------------------------

GROQ_API_KEY=

GROQ_MODEL=llama-3.3-70b-versatile

GROQ_TIMEOUT_SECONDS=15


# ---------------------------------------------------------
# GEMINI
# ---------------------------------------------------------

GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash-lite

GEMINI_TIMEOUT_SECONDS=8