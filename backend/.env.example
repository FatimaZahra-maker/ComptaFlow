APP_NAME=ComptaFlow API
APP_ENV=development
DEBUG=false

DATABASE_URL=postgresql+psycopg://comptaflow:comptaflow_dev_password@localhost:5433/comptaflow_db
REDIS_URL=redis://localhost:6380/0

# Minimum 32 caractères.
# Générer une vraie clé aléatoire dans backend/.env.
SECRET_KEY=remplacer-par-une-cle-secrete-longue-et-aleatoire
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Plusieurs URL séparées par des virgules.
CORS_ORIGINS=http://localhost:5173

STORAGE_PATH=./storage_local
MAX_UPLOAD_SIZE_MB=20

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
AI_PROVIDER=local

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=15

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=8